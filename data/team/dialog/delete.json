{
  "type": "minecraft:confirmation",
  "title": {"text": "Borrar team", "color": "red", "bold": true},
  "body": {"type": "minecraft:plain_message", "contents": {"text": "Todos sus miembros se quedarán sin team. No se puede deshacer.", "color": "gray"}},
  "pause": false,
  "inputs": [
    {"type": "minecraft:text", "key": "team", "label": "Nombre del team", "max_length": 16, "width": 220}
  ],
  "yes": {"label": {"text": "Borrar", "color": "red"}, "action": {"type": "dynamic/run_command", "template": "function team:cmd/delete {team:\"$(team)\"}"}},
  "no": {"label": "Volver", "action": {"type": "show_dialog", "dialog": "team:menu"}}
}
