{
  "type": "minecraft:confirmation",
  "title": {"text": "Agregar jugador", "color": "aqua", "bold": true},
  "body": {"type": "minecraft:plain_message", "contents": {"text": "Si el jugador ya estaba en otro team, se cambia a este.", "color": "gray"}},
  "pause": false,
  "inputs": [
    {"type": "minecraft:text", "key": "player", "label": "Nick del jugador", "max_length": 16, "width": 220},
    {"type": "minecraft:text", "key": "team", "label": "Nombre del team", "max_length": 16, "width": 220}
  ],
  "yes": {"label": {"text": "Agregar", "color": "aqua"}, "action": {"type": "dynamic/run_command", "template": "function team:cmd/add {player:\"$(player)\",team:\"$(team)\"}"}},
  "no": {"label": "Volver", "action": {"type": "show_dialog", "dialog": "team:menu"}}
}
