{
  "type": "minecraft:multi_action",
  "title": {"text": "Team Forge", "color": "gold", "bold": true},
  "external_title": {"text": "Team Forge", "color": "gold"},
  "body": {"type": "minecraft:plain_message", "contents": {"text": "Crea teams o títulos que aparecen como [Nombre] en el chat, en el tab y encima del jugador.", "color": "gray"}},
  "columns": 2,
  "pause": false,
  "actions": [
    {"label": {"text": "✚ Nuevo team", "color": "green"}, "tooltip": "Crear un team nuevo con nombre y color", "action": {"type": "show_dialog", "dialog": "team:new"}},
    {"label": {"text": "✖ Borrar team", "color": "red"}, "tooltip": "Eliminar un team existente", "action": {"type": "show_dialog", "dialog": "team:delete"}},
    {"label": {"text": "➕ Agregar jugador", "color": "aqua"}, "tooltip": "Meter a un jugador en un team", "action": {"type": "show_dialog", "dialog": "team:add"}},
    {"label": {"text": "➖ Quitar jugador", "color": "yellow"}, "tooltip": "Sacar a un jugador de su team", "action": {"type": "show_dialog", "dialog": "team:remove"}},
    {"label": {"text": "☰ Ver teams", "color": "white"}, "tooltip": "Lista los teams en el chat", "action": {"type": "run_command", "command": "team list"}}
  ],
  "exit_action": {"label": "Cerrar"}
